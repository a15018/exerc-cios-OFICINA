programa {
	inteiro n1,n2, s // declaração das variaveis
	//tipos de dados
	/* inteiro -> números inteiros
		real -> números decimais
		caractere -> um caractér
		cadeia -> texto
		logico -> verdadeiro ou falso*/
	funcao inicio() {
		n1 = 5 // inicialisação da variavel
		escreva("digite o valor de n2 ")
		leia(n2)
		s = n1 + n2
		escreva("a soma de ",n1," com ",n2," é igual a ",s)
	}
}
